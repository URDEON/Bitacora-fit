{
  "name": "bitacora-fit-pro",
  "private": true,
  "version": "5.1.0",
  "description": "Bitácora Fit Pro — entrenamiento, alimentación y progreso sin conexión",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-offline.mjs",
    "preview": "vite preview",
    "cap:sync": "npx cap sync android",
    "typecheck": "tsc --noEmit",
    "test": "node tests/run.mjs",
    "android:build": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@fontsource/archivo": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.0",
    "@fontsource/plus-jakarta-sans": "^5.1.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.35.5",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  },
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.4"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
